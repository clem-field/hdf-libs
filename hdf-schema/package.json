{
  "name": "@mitre/hdf-schema",
  "version": "0.1.0",
  "description": "JSON schemas and multi-language type definitions for Heimdall Data Format (HDF)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schemas/*": "./src/schemas/*"
  },
  "files": [
    "dist",
    "src/schemas"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "generate:types": "./scripts/generate-types.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitre/hdf-libs.git",
    "directory": "hdf-schema"
  },
  "author": "MITRE Corporation",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0"
  },
  "devDependencies": {
    "quicktype-core": "^23.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "hdf",
    "heimdall",
    "security",
    "json-schema",
    "inspec",
    "stig",
    "compliance"
  ]
}
